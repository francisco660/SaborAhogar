# Cadena de conexión a PostgreSQL
#   Local:  postgres://postgres:CLAVE@localhost:5432/pos_restaurante
#   Neon:   postgres://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:CLAVE@localhost:5432/pos_restaurante

# Secreto para firmar las sesiones (cadena larga y aleatoria)
JWT_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria

# Duración de la sesión
JWT_EXPIRA=12h

PORT=4100
